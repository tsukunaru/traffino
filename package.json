    "package": "npm run check && node scripts/package.mjs"
  },
  "dependencies": {
    "core-js": "^3.50.0",
    "three": "0.160.1"
  },
  "devDependencies": {
    "@babel/core": "^7.29.7",
    "@babel/preset-env": "^7.29.7",
