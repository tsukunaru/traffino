{
  "name": "traffino",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "main": "desktop/main.cjs",
  "scripts": {
    "desktop": "npm run build && electron .",
    "package:windows": "npm run build && node scripts/package-windows.mjs",
    "dev": "node scripts/serve.mjs --dev",
    "preview": "node scripts/serve.mjs",
    "test": "node --test tests/*.test.mjs",
    "build": "node scripts/build.mjs",
    "build:dev": "node scripts/build.mjs --dev",
    "profile": "node scripts/profile.mjs",
